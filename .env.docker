DEBUG=1
SECRET_KEY=12DB8gdcT0IbPNmfgiQYPo9JALuEfgDWozK9Rlw_6YY_7EPyLPPQFJez3DIaF-Ma

# -----------------------
# Postgres (для Django settings.py)
# ВАЖНО: внутри docker-сети HOST=db и PORT=5432
# -----------------------
POSTGRES_DB=procurement_db
POSTGRES_USER=procurement_user
POSTGRES_PASSWORD=procurement_password-132345
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------
# Email (settings.py использует только эти)
# -----------------------
DEFAULT_FROM_EMAIL=no-reply@retail.local
ADMIN_EMAIL=admin@retail.local

# -----------------------
# Celery (settings.py читает эти)
# ВАЖНО: внутри docker-сети redis слушает 6379
# -----------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Для docker/dev обычно 0 (не eager)
CELERY_TASK_ALWAYS_EAGER=0

# Redis cache (отдельная DB, чтобы не мешать Celery)
REDIS_CACHE_URL=redis://redis:6379/2

# ORM cache switch
CACHALOT_ENABLED=1